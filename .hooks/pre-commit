#!/bin/sh
set -e

# Git hooks run with minimal PATH - add common Node.js locations
export PATH="$HOME/.nvm/versions/node/$(ls $HOME/.nvm/versions/node 2>/dev/null | tail -1)/bin:$PATH" 2>/dev/null || true
export PATH="/usr/local/bin:/opt/homebrew/bin:$HOME/.volta/bin:$PATH"

# Rebuild the browser bundle (minified with source map)
echo "🦍 Building dist/ape.js..."
npx esbuild client/browser.js --bundle --minify --sourcemap --outfile=dist/ape.js

# Check if the bundle or map changed and stage them
if git diff --quiet dist/ape.js dist/ape.js.map 2>/dev/null; then
    echo "🦍 dist/ape.js unchanged"
else
    echo "🦍 dist/ape.js changed, adding to commit"
    git add dist/ape.js dist/ape.js.map
fi
