{
    "compilerOptions": {
        "lib": [
            "ESNext"
        ],
        "module": "ESNext",
        "target": "ESNext",
        "moduleResolution": "Bundler",
        "types": [
            "bun-types"
        ],
        "noEmit": true,
        "strict": true,
        "skipLibCheck": true,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true
    },
    "include": ["**/*.ts", ".api-ape/**/*"]
}